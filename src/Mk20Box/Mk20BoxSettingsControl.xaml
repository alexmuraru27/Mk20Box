<UserControl x:Class="Mk20Box.Mk20BoxSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins"
             xmlns:ui="clr-namespace:Mk20Box.Ui"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary Source="pack://application:,,,/Mk20Box;component/Ui/DeviceLayoutResources.xaml" />
    </UserControl.Resources>
    <ScrollViewer>
        <styles:SHSection Title="MK20BOX" ShowSeparator="True">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="DeviceMenuButton"
                            Width="140" Height="34"
                            Margin="0,0,8,0"
                            Click="ToggleDeviceMenu_Click"
                            Content="Device" />
                    <Button x:Name="LayoutMenuButton"
                            Width="140" Height="34"
                            Margin="0,0,8,0"
                            Click="ToggleLayoutMenu_Click"
                            Content="Device layout" />
                    <Button x:Name="ProfilesMenuButton"
                            Width="140" Height="34"
                            Click="ToggleProfilesMenu_Click"
                            Content="Profiles" />
                </StackPanel>

                <Border x:Name="DeviceMenuPanel" Style="{StaticResource Mk20SectionBorderStyle}">
                    <StackPanel>
                        <Border Style="{StaticResource Mk20SectionHeaderBorderStyle}">
                            <TextBlock Style="{StaticResource Mk20SectionHeaderTextStyle}" Text="DEVICE" />
                        </Border>
                        <StackPanel MaxWidth="900" Margin="12">
                        <TextBlock Margin="0,0,0,12" Opacity="0.7" TextWrapping="Wrap"
                                   Text="Choose the serial port the MK20 is connected to. The port is remembered, and SimHub reconnects to it on start." />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="COM port" />
                            <ComboBox x:Name="DevicePortCombo"
                                      Grid.Column="1" Height="30"
                                      SelectionChanged="DevicePortChanged" />
                            <Button x:Name="RefreshPortsButton"
                                    Grid.Column="2"
                                    Height="30" Margin="8,0,0,0" Padding="10,0"
                                    Click="RefreshPorts_Click"
                                    Content="Refresh" />
                        </Grid>

                        <WrapPanel Margin="0,0,0,12">
                            <Button x:Name="ConnectButton"
                                    Height="30" Margin="0,0,8,0" Padding="14,0"
                                    Click="ConnectDevice_Click"
                                    Content="Connect" />
                            <Button x:Name="DisconnectButton"
                                    Height="30" Margin="0,0,8,0" Padding="14,0"
                                    Click="DisconnectDevice_Click"
                                    Content="Disconnect" />
                            <CheckBox x:Name="AutoConnectCheckBox"
                                      VerticalAlignment="Center"
                                      Click="AutoConnect_Click"
                                      Content="Connect automatically on start" />
                            <CheckBox x:Name="AutoUploadCheckBox"
                                      VerticalAlignment="Center" Margin="16,0,0,0"
                                      Click="AutoUpload_Click"
                                      Content="Load matching profile when a game starts" />
                            <TextBlock VerticalAlignment="Center" Margin="16,0,6,0"
                                       Text="Macro key delay (ms)" />
                            <TextBox x:Name="InputDelayTextBox"
                                     Width="52" Height="26"
                                     VerticalContentAlignment="Center"
                                     TextChanged="InputDelay_TextChanged"
                                     ToolTip="Pause between keystrokes and typed characters. Raise this if a macro loses or reorders characters." />
                        </WrapPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="0,0,8,0" FontWeight="SemiBold" Text="Status:" />
                            <TextBlock x:Name="DeviceStatusText" Grid.Column="1" TextWrapping="Wrap" />
                        </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="LayoutMenuPanel" Style="{StaticResource Mk20SectionBorderStyle}">
                    <StackPanel>
                        <Border Style="{StaticResource Mk20SectionHeaderBorderStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Mk20SectionHeaderTextStyle}" Text="DEVICE LAYOUT" />
                                <TextBlock x:Name="EditingProfileText"
                                           Style="{StaticResource Mk20SectionHeaderTextStyle}"
                                           Opacity="0.75" />
                            </StackPanel>
                        </Border>
                        <StackPanel Margin="12">
                        <TextBlock Margin="0,0,0,12" Opacity="0.7" TextWrapping="Wrap"
                                   Text="Lay out the keys for the selected profile. Pages step through with previous/next; a folder is opened from a key on its parent page and returns with the bottom-right key." />

                        <StackPanel x:Name="LayoutEditor">

                        <!-- Page bar: pages are numbered, folders are reached through keys -->
                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <Button Width="30" Height="30"
                                        Command="{Binding PreviousPageCommand}"
                                        Content="&lt;" ToolTip="Previous page" />
                                <Border Width="110" Height="30" Margin="6,0"
                                        Background="#0D141B" BorderBrush="#2E3B47" BorderThickness="1"
                                        CornerRadius="4">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Text="{Binding PageIndicator}" />
                                </Border>
                                <Button Width="30" Height="30" Margin="0,0,6,0"
                                        Command="{Binding NextPageCommand}"
                                        Content="&gt;" ToolTip="Next page" />

                                <Button Width="76" Height="30" Margin="0,0,14,0"
                                        Command="{Binding GoBackCommand}"
                                        Content="&#x21B0; Back"
                                        IsEnabled="{Binding CanGoBack}"
                                        ToolTip="Leave this folder" />

                                <Button Width="86" Height="30" Margin="0,0,4,0"
                                        Command="{Binding AddPageCommand}" Content="Add page" />
                                <Button Width="94" Height="30" Margin="0,0,14,0"
                                        Command="{Binding DeletePageCommand}" Content="Delete page" />

                                <Button x:Name="SendToDeviceButton"
                                        Width="120" Height="30" Margin="0,0,14,0"
                                        Click="SendToDevice_Click"
                                        Content="Send to device"
                                        ToolTip="Build this profile's theme and upload it to the MK20" />

                                <TextBlock VerticalAlignment="Center"
                                           Foreground="{StaticResource Mk20MutedTextBrush}"
                                           Text="{Binding BreadcrumbText}" />
                            </StackPanel>
                        </Grid>

                        <!-- Device schematic + the panel for whatever is being edited -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- Both pinned: an Auto column would be resized by the
                                     panel's content and move the schematic -->
                                <ColumnDefinition Width="470" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="470" />
                            </Grid.ColumnDefinitions>

                            <!-- Scaled down as a whole, so every part keeps its proportions
                                 and the drag maths still works in the unscaled space -->
                            <Viewbox Width="470" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Border Width="560" Height="540"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource Mk20ShellBrush}"
                                    BorderBrush="{StaticResource Mk20ShellBorderBrush}"
                                    BorderThickness="2"
                                    CornerRadius="26">
                                <Grid Margin="20">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="112" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Encoders flanking the secondary display -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="88" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="88" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button Click="SelectLeftEncoder_Click"
                                                    Style="{StaticResource Mk20EncoderStyle}"
                                                    ToolTip="Left encoder - click to configure" />
                                            <TextBlock Margin="0,5,0,0" HorizontalAlignment="Center"
                                                       FontSize="10"
                                                       Foreground="{StaticResource Mk20MutedTextBrush}"
                                                       Text="ENCODER 1" />
                                        </StackPanel>

                                        <Border Grid.Column="1" Margin="8,2"
                                                Background="{StaticResource Mk20SecondaryScreenBrush}"
                                                BorderBrush="{StaticResource Mk20SecondaryScreenBorderBrush}"
                                                BorderThickness="2"
                                                CornerRadius="8">
                                            <Grid x:Name="SecondaryScreenSurface"
                                                  Background="Transparent"
                                                  ClipToBounds="True"
                                                  MouseLeftButtonDown="SecondaryBackground_MouseDown"
                                                  MouseMove="SecondaryBackground_MouseMove"
                                                  MouseLeftButtonUp="SecondaryBackground_MouseUp"
                                                  ToolTip="Drag to choose which part shows. Double-click to centre, right-click for options.">
                                                <Grid.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Click="ChooseSecondaryBackground_Click"
                                                                  Header="Choose picture..." />
                                                        <MenuItem Click="ClearSecondaryBackground_Click"
                                                                  Header="Remove picture"
                                                                  IsEnabled="{Binding SecondaryPage.HasSecondaryBackground, FallbackValue=False}" />
                                                        <Separator />
                                                        <MenuItem Click="SecondaryFitMode_Click"
                                                                  Header="Show whole picture"
                                                                  IsCheckable="True"
                                                                  IsChecked="{Binding SecondaryPage.SecondaryBackgroundFit, Mode=TwoWay}"
                                                                  IsEnabled="{Binding SecondaryPage.HasSecondaryBackground, FallbackValue=False}"
                                                                  ToolTip="Keep the original proportions. Untick to fill the screen and crop." />
                                                    </ContextMenu>
                                                </Grid.ContextMenu>

                                                <!-- Exactly the crop the composer will send, animated for GIFs. -->
                                                <ui:AnimatedImage SourcePath="{Binding SecondaryPage.SecondaryBackgroundPath}"
                                                                  Viewbox="{Binding SecondaryPage.SecondaryBackgroundViewbox}"
                                                                  Stretch="{Binding SecondaryPage.SecondaryStretch}" />

                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Visibility="{Binding SecondaryPage.HasSecondaryBackground, Converter={StaticResource InverseBooleanToVisibility}, FallbackValue=Visible}">
                                                    <TextBlock HorizontalAlignment="Center"
                                                               FontSize="10"
                                                               Foreground="{StaticResource Mk20MutedTextBrush}"
                                                               Text="click to edit, right-click to add a picture" />
                                                </StackPanel>

                                                <TextBlock Margin="0,0,0,3"
                                                           HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                           FontSize="9"
                                                           Foreground="#B0FFFFFF"
                                                           Text="{Binding SecondaryPage.SecondaryPanHint}" />

                                                <!-- Widgets, drawn where they will appear and draggable.
                                                     The canvas is the real 428x142 so positions map 1:1. -->
                                                <Viewbox Stretch="Fill">
                                                    <ItemsControl x:Name="WidgetOverlay"
                                                                  Width="428" Height="142"
                                                                  ItemsSource="{Binding SecondaryPage.Widgets}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <Canvas />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>                                                        <ItemsControl.ItemContainerStyle>
                                                            <Style TargetType="ContentPresenter">
                                                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                                            </Style>
                                                        </ItemsControl.ItemContainerStyle>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Width="{Binding DisplayWidth}"
                                                                      Height="{Binding DisplayHeight}"
                                                                      Background="#01FFFFFF"
                                                                      MouseLeftButtonDown="Widget_MouseDown"
                                                                      MouseMove="Widget_MouseMove"
                                                                      MouseLeftButtonUp="Widget_MouseUp"
                                                                      ToolTip="{Binding Description}">
                                                                    <!-- Marks the widget being edited, so the list and
                                                                         the screen always agree -->
                                                                    <Rectangle Margin="-3"
                                                                               Fill="#2624C8B0"
                                                                               RadiusX="3" RadiusY="3"
                                                                               Stroke="{StaticResource Mk20AccentBrush}"
                                                                               StrokeDashArray="3 2"
                                                                               StrokeThickness="1.5"
                                                                               Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibility}, FallbackValue=Collapsed}" />

                                                                    <!-- A bar is a filled box; text draws itself -->
                                                                    <Border Background="#5A000000"
                                                                            BorderBrush="{Binding Brush}" BorderThickness="1"
                                                                            CornerRadius="3"
                                                                            Visibility="{Binding IsBar, Converter={StaticResource BooleanToVisibility}}">
                                                                        <Rectangle Margin="2"
                                                                                   HorizontalAlignment="Left"
                                                                                   Width="{Binding PreviewFillWidth}"
                                                                                   Fill="{Binding Brush}"
                                                                                   RadiusX="2" RadiusY="2" />
                                                                    </Border>

                                                                    <!-- A clock is one box per field, digits centred,
                                                                         with no separator - exactly as the device draws it -->
                                                                    <ItemsControl ItemsSource="{Binding ClockDigits}"
                                                                                  Margin="{Binding DigitGroupMargin}"
                                                                                  Visibility="{Binding IsClock, Converter={StaticResource BooleanToVisibility}, FallbackValue=Collapsed}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <StackPanel Orientation="Horizontal" />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Grid Width="{Binding DataContext.DigitWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                      Height="{Binding DataContext.DigitHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                      Margin="{Binding DataContext.DigitMargin, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                               FontFamily="Microsoft YaHei"
                                                                                               FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                               Foreground="{Binding DataContext.Brush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                               Text="{Binding}" />
                                                                                </Grid>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>

                                                                    <TextBlock VerticalAlignment="Center"
                                                                               FontFamily="Microsoft YaHei"
                                                                               FontSize="{Binding FontSize}"
                                                                               Foreground="{Binding Brush}"
                                                                               Text="{Binding Preview}"
                                                                               Visibility="{Binding IsPlainText, Converter={StaticResource BooleanToVisibility}, FallbackValue=Visible}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Viewbox>
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button Click="SelectRightEncoder_Click"
                                                    Style="{StaticResource Mk20EncoderStyle}"
                                                    ToolTip="Right encoder - click to configure" />
                                            <TextBlock Margin="0,5,0,0" HorizontalAlignment="Center"
                                                       FontSize="10"
                                                       Foreground="{StaticResource Mk20MutedTextBrush}"
                                                       Text="ENCODER 2" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- 4 x 5 key grid -->
                                    <Border Grid.Row="2" Padding="6"
                                            Background="{StaticResource Mk20GridBackgroundBrush}"
                                            BorderBrush="{StaticResource Mk20GridBorderBrush}"
                                            BorderThickness="2"
                                            CornerRadius="13">
                                        <ListBox x:Name="KeyGrid"
                                                 Background="Transparent" BorderThickness="0"
                                                 ItemContainerStyle="{StaticResource Mk20KeyStyle}"
                                                 ItemTemplate="{StaticResource Mk20KeyTemplate}"
                                                 ItemsSource="{Binding SelectedPage.Keys}"
                                                 MouseDoubleClick="KeyGrid_MouseDoubleClick"
                                                 PreviewMouseLeftButtonDown="KeyGrid_PreviewMouseDown"
                                                 PreviewMouseRightButtonDown="KeyGrid_RightButtonDown"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                 SelectedItem="{Binding SelectedKey, Mode=TwoWay}"
                                                 ToolTip="Right-click a key for picture options. Double-click a navigation key to follow it.">
                                            <ListBox.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Click="ChooseKeyMedia_Click" Header="Choose picture..." />
                                                    <MenuItem Click="BrowseKeyMedia_Click" Header="Choose from file..." />
                                                    <MenuItem Click="ClearKeyMedia_Click"
                                                              Header="Remove picture"
                                                              IsEnabled="{Binding SelectedKey.HasMedia, FallbackValue=False}" />
                                                    <Separator />
                                                    <MenuItem Click="KeyIconFitMode_Click"
                                                              Header="Show whole picture"
                                                              IsCheckable="True"
                                                              IsChecked="{Binding SelectedKey.IconFit, Mode=TwoWay}"
                                                              IsEnabled="{Binding SelectedKey.HasMedia, FallbackValue=False}"
                                                              ToolTip="Keep the original proportions. Untick to fill the key and crop to its centre." />
                                                </ContextMenu>
                                            </ListBox.ContextMenu>
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="5" Rows="4" />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                        </ListBox>
                                    </Border>
                                </Grid>
                            </Border>
                            </Viewbox>

                            <!-- Active operation panel: follows whatever is clicked on the device -->
                            <Border Grid.Column="2" Padding="12"
                                    Background="#141B22" BorderBrush="#2A3742" BorderThickness="1"
                                    CornerRadius="6">
                                <StackPanel>
                                    <Border Margin="0,0,0,10" Padding="8,5"
                                            Background="#182430" CornerRadius="3">
                                        <TextBlock FontWeight="SemiBold"
                                                   Foreground="{StaticResource Mk20AccentBrush}"
                                                   Text="{Binding ActiveInspectorTitle}" />
                                    </Border>

                                    <!-- SECONDARY SCREEN -->
                                    <StackPanel Visibility="{Binding ShowsSecondaryInspector, Converter={StaticResource BooleanToVisibility}, FallbackValue=Collapsed}">
                                        <TextBlock Margin="0,0,0,8" Opacity="0.7" TextWrapping="Wrap"
                                                   Text="Show live SimHub values on the small screen: speed, fuel, TC, ABS and anything else the game reports." />

                                        <CheckBox Margin="0,0,0,10"
                                                  Click="GlobalSecondaryScreen_Click"
                                                  Content="Use one screen for every page and folder"
                                                  IsChecked="{Binding GlobalSecondaryScreen, Mode=TwoWay}"
                                                  ToolTip="The picture and widgets from page 1 are copied onto every page when the layout is built." />

                                        <StackPanel DataContext="{Binding SecondaryPage}">
                                            <TextBlock Margin="0,0,0,3" Opacity="0.7" Text="Widgets" />
                                            <ListBox x:Name="WidgetList"
                                                     Height="104"
                                                     DisplayMemberPath="Description"
                                                     ItemsSource="{Binding Widgets}"
                                                     SelectionChanged="WidgetSelected" />
                                            <WrapPanel Margin="0,6,0,0">
                                                <Button Width="60" Height="26" Margin="0,0,4,0"
                                                        Click="AddWidget_Click" Content="Add" />
                                                <Button Width="70" Height="26"
                                                        Click="RemoveWidget_Click" Content="Remove" />
                                            </WrapPanel>
                                        </StackPanel>

                                        <Border Height="1" Margin="0,10"
                                                Background="{StaticResource Mk20GridBorderBrush}" />

                                        <Grid DataContext="{Binding SelectedItem, ElementName=WidgetList}">
                                            <TextBlock Opacity="0.6"
                                                       Text="Add a widget, or select one to edit it."
                                                       Visibility="{Binding Converter={StaticResource NullToVisibility}}" />

                                            <StackPanel Visibility="{Binding Converter={StaticResource NotNullToVisibility}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="6" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Margin="0,0,0,2" Opacity="0.7" Text="Type" />
                                                    <ComboBox x:Name="WidgetKindCombo"
                                                              Grid.Row="1" Height="26"
                                                              SelectedItem="{Binding Kind, Mode=TwoWay}"
                                                              SelectionChanged="WidgetChanged" />

                                                    <StackPanel Grid.Column="2" Grid.RowSpan="2"
                                                                Visibility="{Binding IsClock, Converter={StaticResource InverseBooleanToVisibility}, FallbackValue=Visible}">
                                                        <TextBlock Margin="0,0,0,2" Opacity="0.7" Text="Label" />
                                                        <TextBox Height="26"
                                                                 Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- A clock is fed by hour/minute/second, never by a property -->
                                                <StackPanel Visibility="{Binding IsClock, Converter={StaticResource InverseBooleanToVisibility}, FallbackValue=Visible}">
                                                    <TextBlock Margin="0,8,0,2" Opacity="0.7" Text="SimHub value" />
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Height="26" Margin="0,0,6,0"
                                                                 IsReadOnly="True"
                                                                 Text="{Binding Property, Mode=OneWay}" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <Button Width="70" Height="26" Margin="0,0,4,0"
                                                                    Click="ChooseProperty_Click" Content="Choose..." />
                                                            <Button Width="56" Height="26"
                                                                    Click="ClearProperty_Click" Content="Clear" />
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>

                                                <!-- Fixed text, only when nothing is streamed -->
                                                <StackPanel Visibility="{Binding ShowsText, Converter={StaticResource BooleanToVisibility}, FallbackValue=Collapsed}">
                                                    <TextBlock Margin="0,8,0,2" Opacity="0.7" Text="Fixed text" />
                                                    <TextBox Height="26"
                                                             Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>

                                                <!-- Text only: a bar draws no number and a clock formats its own -->
                                                <Grid Margin="0,8,0,0"
                                                      Visibility="{Binding IsText, Converter={StaticResource BooleanToVisibility}, FallbackValue=Collapsed}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="6" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="6" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Margin="0,0,0,2" Opacity="0.7" Text="Decimals" />
                                                    <TextBox Grid.Row="1" Height="26"
                                                             Text="{Binding Decimals, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                                    <StackPanel Grid.Column="2" Grid.RowSpan="2">
                                                        <TextBlock Margin="0,0,0,2" Opacity="0.7" Text="Unit" />
                                                        <TextBox Height="26"
                                                                 Text="{Binding Unit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="4" Grid.RowSpan="2">
                                                        <TextBlock Margin="0,0,0,2" Opacity="0.7" Text="Text size" />
                                                        <TextBox Height="26"
                                                                 Text="{Binding FontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Progress bar only -->
                                                <StackPanel Visibility="{Binding IsBar, Converter={StaticResource BooleanToVisibility}, FallbackValue=Collapsed}">
                                                    <Grid Margin="0,8,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="6" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="6" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="6" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Margin="0,0,0,2" Opacity="0.7" Text="MinValue" />
                                                        <TextBox Grid.Row="1" Height="26"
                                                                 Text="{Binding Minimum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                                        <TextBlock Grid.Column="2" Margin="0,0,0,2" Opacity="0.7" Text="MaxValue" />
                                                        <TextBox Grid.Row="1" Grid.Column="2" Height="26"
                                                                 Text="{Binding Maximum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                                        <TextBlock Grid.Column="4" Margin="0,0,0,2" Opacity="0.7" Text="Width" />
                                                        <TextBox Grid.Row="1" Grid.Column="4" Height="26"
                                                                 Text="{Binding BarWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                                        <TextBlock Grid.Column="6" Margin="0,0,0,2" Opacity="0.7" Text="Height" />
                                                        <TextBox Grid.Row="1" Grid.Column="6" Height="26"
                                                                 Text="{Binding BarHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    </Grid>
                                                </StackPanel>

                                                <!-- Outline text only: the stroke that distinguishes
                                                     item type 117 from plain text (113) -->
                                                <StackPanel Visibility="{Binding IsOutline, Converter={StaticResource BooleanToVisibility}, FallbackValue=Collapsed}">
                                                    <Grid Margin="0,8,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="6" />
                                                            <ColumnDefinition Width="56" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Margin="0,0,0,2" Opacity="0.7" Text="Outline" />
                                                        <ui:HexColorPicker x:Name="OutlineColorPicker"
                                                                           Grid.Row="1" Height="26"
                                                                           HexColor="{Binding OutlineColor, Mode=TwoWay}"
                                                                           SelectedColorChanged="WidgetColorChanged" />

                                                        <TextBlock Grid.Column="2" Margin="0,0,0,2" Opacity="0.7" Text="Width" />
                                                        <TextBox Grid.Row="1" Grid.Column="2" Height="26"
                                                                 Text="{Binding OutlineWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    </Grid>

                                                    <TextBlock Margin="0,4,0,0" Opacity="0.55" TextWrapping="Wrap"
                                                               Text="A stroke around the text keeps it readable over a picture or GIF. Set the width to 0 for plain text." />
                                                </StackPanel>

                                                <!-- Clock only -->
                                                <StackPanel Visibility="{Binding IsClock, Converter={StaticResource BooleanToVisibility}, FallbackValue=Collapsed}">
                                                    <CheckBox Margin="0,8,0,0"
                                                              Click="WidgetFieldChanged"
                                                              Content="Show seconds"
                                                              IsChecked="{Binding ShowSeconds, Mode=TwoWay}" />

                                                    <Grid Margin="0,8,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="6" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Margin="0,0,0,2" Opacity="0.7" Text="Text size" />
                                                        <TextBox Grid.Row="1" Height="26"
                                                                 Text="{Binding FontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                                        <TextBlock Grid.Column="2" Margin="0,0,0,2" Opacity="0.7" Text="Spacing" />
                                                        <TextBox Grid.Row="1" Grid.Column="2" Height="26"
                                                                 Text="{Binding Spacing, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 ToolTip="Pixels between the hour, minute and second boxes. Use a negative value to pull them closer together." />
                                                    </Grid>

                                                    <TextBlock Margin="0,4,0,0" Opacity="0.55" TextWrapping="Wrap"
                                                               Text="The device draws no colon and has no letter-spacing, so the gap between the pairs is set here. Negative values close it up." />
                                                </StackPanel>

                                                <!-- Exact placement; dragging is only a rough guide -->
                                                <TextBlock Margin="0,10,0,2" Opacity="0.7"
                                                           Text="Position on the 428 x 142 screen" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Margin="0,0,4,0" VerticalAlignment="Center" Text="X" />
                                                    <TextBox Grid.Column="1" Height="26"
                                                             Text="{Binding X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0}}" />

                                                    <TextBlock Grid.Column="3" Margin="0,0,4,0" VerticalAlignment="Center" Text="Y" />
                                                    <TextBox Grid.Column="4" Height="26"
                                                             Text="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0}}" />
                                                </Grid>

                                                <TextBlock Margin="0,4,0,0" Opacity="0.55" TextWrapping="Wrap"
                                                           Text="Dragging on the screen above sets these too." />

                                                <TextBlock Margin="0,8,0,2" Opacity="0.7" Text="Colour" />
                                                <ui:HexColorPicker x:Name="WidgetColorPicker"
                                                                   Height="26"
                                                                   HexColor="{Binding Color, Mode=TwoWay}"
                                                                   SelectedColorChanged="WidgetColorChanged" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                <!-- KEY -->
                                <StackPanel Visibility="{Binding ShowsKeyInspector, Converter={StaticResource BooleanToVisibility}}">
                                    <StackPanel DataContext="{Binding SelectedKey}">
                                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Name}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   Foreground="{StaticResource Mk20MutedTextBrush}"
                                                   Text="{Binding Position}" />

                                        <TextBlock Margin="0,14,0,4" FontWeight="SemiBold" Text="Button text" />
                                        <TextBox Height="26"
                                                 Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Margin="0,0,0,2" Opacity="0.7" Text="Colour" />
                                            <ui:HexColorPicker x:Name="TitleColorPicker"
                                                               Grid.Row="1" Height="26"
                                                               HexColor="{Binding TitleColor, Mode=TwoWay}"
                                                               SelectedColorChanged="KeyColorChanged" />

                                            <TextBlock Grid.Column="2" Margin="0,0,0,2" Opacity="0.7" Text="Size" />
                                            <ComboBox x:Name="TitleSizeCombo"
                                                      Grid.Row="1" Grid.Column="2" Height="26"
                                                      SelectedItem="{Binding TitleFontSize, Mode=TwoWay}"
                                                      SelectionChanged="KeyStyleChanged" />

                                            <TextBlock Grid.Column="4" Margin="0,0,0,2" Opacity="0.7" Text="Position" />
                                            <ComboBox x:Name="TitlePositionCombo"
                                                      Grid.Row="1" Grid.Column="4" Height="26"
                                                      SelectedItem="{Binding TitlePosition, Mode=TwoWay}"
                                                      SelectionChanged="KeyStyleChanged" />
                                        </Grid>

                                        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap"
                                                   Foreground="{StaticResource Mk20MutedTextBrush}"
                                                   Text="Right-click the key on the left to choose its picture." />
                                    </StackPanel>

                                    <TextBlock Margin="0,16,0,6" FontWeight="SemiBold" Text="Action" />
                                    <ComboBox Height="30"
                                              ItemsSource="{Binding ActionTypes}"
                                              SelectedItem="{Binding SelectedKey.ActionType, Mode=TwoWay}" />

                                    <!-- Keystroke: recorded, not picked from a list -->
                                    <StackPanel Visibility="{Binding SelectedKey.SendsKeystroke, Converter={StaticResource BooleanToVisibility}}">
                                        <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="Keystroke" />
                                        <ui:KeystrokeRecorder x:Name="KeyKeystrokeRecorder"
                                                              Height="30"
                                                              Keystroke="{Binding SelectedKey.Keystroke, Mode=TwoWay}"
                                                              Recorded="KeystrokeRecorded" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Foreground="{StaticResource Mk20MutedTextBrush}"
                                                   Text="Sent by the device itself, so it still works when SimHub is closed."
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Macro: replayed by the plugin -->
                                    <StackPanel Visibility="{Binding SelectedKey.RunsMacro, Converter={StaticResource BooleanToVisibility}}">
                                        <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="Steps" />
                                        <ListBox x:Name="MacroStepList"
                                                 Height="150"
                                                 ItemsSource="{Binding SelectedKey.MacroSteps}"
                                                 DisplayMemberPath="Description" />
                                        <!-- Row 1: add steps. Row 2: reorder and remove. -->
                                        <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                            <TextBlock Margin="0,0,8,0" VerticalAlignment="Center"
                                                       Foreground="{StaticResource Mk20MutedTextBrush}"
                                                       Text="Add:" />
                                            <Button Width="62" Height="26" Margin="0,0,4,0"
                                                    Click="AddMacroKeystroke_Click" Content="Key" />
                                            <Button Width="62" Height="26" Margin="0,0,4,0"
                                                    Click="AddMacroText_Click" Content="Text" />
                                            <Button Width="62" Height="26" Margin="0,0,4,0"
                                                    Click="AddMacroDelay_Click" Content="Wait" />
                                            <Button Width="62" Height="26"
                                                    Click="AddMacroAction_Click" Content="Action" />
                                        </StackPanel>

                                        <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                            <Button Width="30" Height="26" Margin="0,0,4,0"
                                                    Click="MoveMacroStepUp_Click" Content="&#x2191;"
                                                    ToolTip="Move step up" />
                                            <Button Width="30" Height="26" Margin="0,0,4,0"
                                                    Click="MoveMacroStepDown_Click" Content="&#x2193;"
                                                    ToolTip="Move step down" />
                                            <Button Width="72" Height="26"
                                                    Click="RemoveMacroStep_Click" Content="Remove" />
                                        </StackPanel>

                                        <!-- Editor for whichever step is selected above -->
                                        <Border Margin="0,10,0,0" Padding="10"
                                                Background="#141B22" BorderBrush="#2A3742" BorderThickness="1">
                                            <Grid>
                                                <TextBlock Foreground="{StaticResource Mk20MutedTextBrush}"
                                                           Text="Select a step above to edit it."
                                                           Visibility="{Binding SelectedItem, ElementName=MacroStepList, Converter={StaticResource NullToVisibility}}" />

                                                <StackPanel DataContext="{Binding SelectedItem, ElementName=MacroStepList}"
                                                            Visibility="{Binding SelectedItem, ElementName=MacroStepList, Converter={StaticResource NotNullToVisibility}}">
                                                    <StackPanel Visibility="{Binding IsKeystroke, Converter={StaticResource BooleanToVisibility}, FallbackValue=Collapsed}">
                                                        <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="Key to press" />
                                                        <ui:KeystrokeRecorder Height="30"
                                                                              Keystroke="{Binding Keystroke, Mode=TwoWay}"
                                                                              Recorded="MacroStepChanged" />
                                                    </StackPanel>

                                                    <StackPanel Visibility="{Binding IsText, Converter={StaticResource BooleanToVisibility}, FallbackValue=Collapsed}">
                                                        <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="Text to type" />
                                                        <TextBox Height="26"
                                                                 Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>

                                                    <StackPanel Visibility="{Binding IsDelay, Converter={StaticResource BooleanToVisibility}, FallbackValue=Collapsed}">
                                                        <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="Wait (milliseconds)" />
                                                        <TextBox Height="26"
                                                                 Text="{Binding DelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>

                                                    <StackPanel Visibility="{Binding IsSimHubAction, Converter={StaticResource BooleanToVisibility}, FallbackValue=Collapsed}">
                                                        <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="SimHub action name" />
                                                        <TextBox Height="26"
                                                                 Text="{Binding ActionName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <TextBlock Margin="0,6,0,0"
                                                   Foreground="{StaticResource Mk20MutedTextBrush}"
                                                   Text="Steps run top to bottom when the device reports the press."
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- SimHub action / input -->
                                    <StackPanel Visibility="{Binding SelectedKey.IsHostRouted, Converter={StaticResource BooleanToVisibility}}">
                                        <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="Name" />
                                        <TextBox Height="26"
                                                 Text="{Binding SelectedKey.ActionTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <!-- Folder owned by this key -->
                                    <StackPanel Visibility="{Binding SelectedKey.OpensFolder, Converter={StaticResource BooleanToVisibility}}">
                                        <Border Margin="0,12,0,0" Padding="10"
                                                Background="#141B22" BorderBrush="#2A3742" BorderThickness="1">
                                            <TextBlock Foreground="{StaticResource Mk20MutedTextBrush}"
                                                       Text="This key opens its own folder. Double-click the key on the grid to go inside, then use Back to return."
                                                       TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- ENCODER -->
                                <StackPanel DataContext="{Binding SelectedEncoder}"
                                            Visibility="{Binding DataContext.ShowsEncoderInspector, ElementName=LayoutMenuPanel, Converter={StaticResource BooleanToVisibility}}">
                                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Name}" />
                                    <TextBlock Margin="0,2,0,0"
                                               Foreground="{StaticResource Mk20MutedTextBrush}"
                                               Text="Configured per page" />

                                    <TextBlock Margin="0,14,0,4" FontWeight="SemiBold" Text="Mode" />
                                    <ComboBox Height="30"
                                              ItemsSource="{Binding Modes}"
                                              SelectedItem="{Binding Mode, Mode=TwoWay}" />

                                    <StackPanel Visibility="{Binding UsesFunction, Converter={StaticResource BooleanToVisibility}}">
                                        <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="Function" />
                                        <ComboBox Height="30"
                                                  ItemsSource="{Binding Functions}"
                                                  SelectedItem="{Binding Function, Mode=TwoWay}" />
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding UsesKeystrokes, Converter={StaticResource BooleanToVisibility}}">
                                        <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="Rotate left" />
                                        <ui:KeystrokeRecorder Height="30" Keystroke="{Binding RotateLeft, Mode=TwoWay}" />
                                        <TextBlock Margin="0,8,0,4" FontWeight="SemiBold" Text="Click" />
                                        <ui:KeystrokeRecorder Height="30" Keystroke="{Binding Click, Mode=TwoWay}" />
                                        <TextBlock Margin="0,8,0,4" FontWeight="SemiBold" Text="Rotate right" />
                                        <ui:KeystrokeRecorder Height="30" Keystroke="{Binding RotateRight, Mode=TwoWay}" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Foreground="{StaticResource Mk20MutedTextBrush}"
                                                   Text="Recommended for sim racing: bind these keys in the game or in SimHub."
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding ShowsDirectionWarning, Converter={StaticResource BooleanToVisibility}}">
                                        <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="Command id" />
                                        <TextBox Height="26"
                                                 Text="{Binding CommandId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Border Margin="0,8,0,0" Padding="8"
                                                Background="#3A2A12" BorderBrush="#7A5A22" BorderThickness="1">
                                            <TextBlock Foreground="#E8C48A"
                                                       Text="The device reports one event for left, right and click alike, so rotation direction cannot be told apart. Use keystrokes if direction matters."
                                                       TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>

                                    <Button Height="28" Margin="0,14,0,0" Padding="10,0"
                                            HorizontalAlignment="Left"
                                            Click="BackToKeys_Click"
                                            Content="Back to keys" />
                                </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                        </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="ProfilesMenuPanel" Style="{StaticResource Mk20SectionBorderStyle}">
                    <StackPanel>
                        <Border Style="{StaticResource Mk20SectionHeaderBorderStyle}">
                            <TextBlock Style="{StaticResource Mk20SectionHeaderTextStyle}" Text="PROFILES" />
                        </Border>
                        <StackPanel MaxWidth="900" Margin="12">
                <TextBlock Margin="0,0,0,12" Opacity="0.7" TextWrapping="Wrap"
                           Text="Create reusable profiles, then select one globally or bind one to each game selected in SimHub." />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="0,0,8,0" FontWeight="SemiBold" Text="Selected game:" />
                    <TextBlock x:Name="ActiveGameText" Grid.Column="1" Margin="0,0,24,0" />
                    <TextBlock Grid.Column="2" Margin="0,0,8,0" FontWeight="SemiBold" Text="Active profile:" />
                    <TextBlock x:Name="ActiveProfileText" Grid.Column="3" />
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <CheckBox x:Name="UseGlobalProfileCheckBox"
                              Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8"
                              IsChecked="{Binding UseGlobalProfile, Mode=TwoWay}"
                              Click="GlobalProfileMode_Click"
                              Content="Use one profile for every game" />

                    <TextBlock x:Name="ProfileForGameLabel"
                               Grid.Row="1" Margin="0,0,8,8" VerticalAlignment="Center"
                               Text="Profile" />
                    <ComboBox x:Name="ActiveProfileCombo"
                              Grid.Row="1" Grid.Column="1" Height="30" Margin="0,0,6,8"
                              ItemsSource="{Binding Profiles}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              SelectionChanged="ActiveProfileChanged" />
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8" Orientation="Horizontal">
                        <Button Margin="0,0,6,0" Padding="10,4"
                                Click="ResetProfile_Click" Content="Reset"
                                ToolTip="Clear this profile back to an empty layout" />
                        <Button Padding="10,4"
                                Click="DeleteProfile_Click" Content="Delete" />
                    </StackPanel>

                    <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="New profile name" />
                    <TextBox x:Name="NewProfileNameTextBox"
                             Grid.Row="2" Grid.Column="1" Height="26" Margin="0,0,6,0" />
                    <Button Grid.Row="2" Grid.Column="2" Padding="10,4"
                            Click="CreateProfile_Click" Content="Create" />
                </Grid>

                <TextBlock x:Name="ProfileHintText"
                           Opacity="0.7" TextWrapping="Wrap" />

                <Separator Margin="0,14,0,10" />

                <StackPanel Orientation="Horizontal">
                    <Button Padding="12,5"
                            Background="#4A1D1D" BorderBrush="#7A2E2E" Foreground="#F5DADA"
                            Click="ResetAllSettings_Click"
                            Content="Reset all MK20Box settings"
                            ToolTip="Deletes every profile, layout and preference, restoring a fresh install" />
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                               Opacity="0.65" TextWrapping="Wrap"
                               Text="Erases every profile, layout, game binding and preference." />
                </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </styles:SHSection>
    </ScrollViewer>
</UserControl>
