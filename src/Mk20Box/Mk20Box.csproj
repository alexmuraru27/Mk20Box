<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Mk20Box</AssemblyName>
    <RootNamespace>Mk20Box</RootNamespace>
    <LangVersion>latest</LangVersion>
    <!-- Properties\AssemblyInfo.cs is kept, so do not generate a second one. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- The device library. Transitive NuGet dependencies flow from here. -->
  <ItemGroup>
    <ProjectReference Include="..\..\external\MK20Control\src\Mk20Control.Protocol\Mk20Control.Protocol.csproj" />
  </ItemGroup>

  <!-- SimHub's own assemblies: reference, never copy. -->
  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.11" />
    <Reference Include="GameReaderCommon">
      <HintPath>$(SIMHUB_INSTALL_PATH)GameReaderCommon.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="InputManagerCS">
      <HintPath>$(SIMHUB_INSTALL_PATH)InputManagerCS.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="SimHub.Logging">
      <HintPath>$(SIMHUB_INSTALL_PATH)SimHub.Logging.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="SimHub.Plugins">
      <HintPath>$(SIMHUB_INSTALL_PATH)SimHub.Plugins.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="WoteverCommon">
      <HintPath>$(SIMHUB_INSTALL_PATH)WoteverCommon.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="WoteverLocalization">
      <HintPath>$(SIMHUB_INSTALL_PATH)WoteverLocalization.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="log4net">
      <HintPath>$(SIMHUB_INSTALL_PATH)log4net.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(SIMHUB_INSTALL_PATH)Newtonsoft.Json.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="MahApps.Metro">
      <HintPath>$(SIMHUB_INSTALL_PATH)MahApps.Metro.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="MahApps.Metro.IconPacks.Core">
      <HintPath>$(SIMHUB_INSTALL_PATH)MahApps.Metro.IconPacks.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="MahApps.Metro.IconPacks.Material">
      <HintPath>$(SIMHUB_INSTALL_PATH)MahApps.Metro.IconPacks.Material.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Xceed.Wpf.Toolkit">
      <HintPath>$(SIMHUB_INSTALL_PATH)Xceed.Wpf.Toolkit.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <!-- Design-time only; not part of the normal build. -->
  <ItemGroup>
    <Page Remove="Properties\DesignTimeResources.xaml" />
    <None Include="Properties\DesignTimeResources.xaml" />
  </ItemGroup>

  <!-- Language files ship beside the DLL rather than being embedded. -->
  <ItemGroup>
    <EmbeddedResource Remove="Languages\**" />
    <Content Include="Languages\Mk20Box.resx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="sdkmenuicon.png" />
  </ItemGroup>

  <!-- Icon library ships beside the plugin so it can be browsed at runtime. -->
  <ItemGroup>
    <None Remove="Mk20Assets\**" />
    <Content Include="Mk20Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Deployment layout:
      <SimHub>\Mk20Box.dll          the plugin itself (SimHub scans the root)
      <SimHub>\Mk20Box\*.dll        private dependencies, bound by DependencyResolver

    Nothing SimHub ships is ever overwritten.

    Opt-in, so an ordinary build never writes into the SimHub installation.
    Use deploy.ps1, or pass -p:DeployToSimHub=true.
  -->
  <Target Name="CopyToSimHub" AfterTargets="Build" Condition="'$(DeployToSimHub)' == 'true'">
    <PropertyGroup>
      <SimHubDir>$(SIMHUB_INSTALL_PATH)</SimHubDir>
      <SimHubPluginDir>$(SimHubDir)Mk20Box\</SimHubPluginDir>
    </PropertyGroup>

    <ItemGroup>
      <PluginAssembly Include="$(TargetDir)$(TargetName).dll;$(TargetDir)$(TargetName).pdb" />
      <PrivateDependency Include="$(TargetDir)*.dll"
                         Exclude="$(TargetDir)$(TargetName).dll" />
      <AssetFile Include="$(TargetDir)Mk20Assets\**\*" />
    </ItemGroup>

    <Copy SourceFiles="@(PluginAssembly)" DestinationFolder="$(SimHubDir)" />
    <Copy SourceFiles="@(PrivateDependency)" DestinationFolder="$(SimHubPluginDir)" />
    <Copy SourceFiles="@(AssetFile)"
          DestinationFiles="@(AssetFile->'$(SimHubPluginDir)Mk20Assets\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectDir)Languages\Mk20Box.resx"
          DestinationFolder="$(SimHubDir)Languages\" />

    <Message Importance="high"
             Text="MK20Box -> $(SimHubDir) (@(PrivateDependency->Count()) dependencies, @(AssetFile->Count()) assets)" />
  </Target>

</Project>
