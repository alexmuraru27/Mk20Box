<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Mk20Box.Ui">

    <ui:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibility" />
    <ui:NullToVisibilityConverter x:Key="NullToVisibility" />
    <ui:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
    <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

    <SolidColorBrush x:Key="Mk20AccentBrush" Color="#24C8B0" />
    <SolidColorBrush x:Key="Mk20PrimaryTextBrush" Color="#F4F7FA" />
    <SolidColorBrush x:Key="Mk20MutedTextBrush" Color="#8492A3" />
    <SolidColorBrush x:Key="Mk20FaintTextBrush" Color="#5E6C79" />
    <SolidColorBrush x:Key="Mk20ShellBrush" Color="#171E25" />
    <SolidColorBrush x:Key="Mk20ShellBorderBrush" Color="#35424E" />
    <SolidColorBrush x:Key="Mk20GridBackgroundBrush" Color="#0B1015" />
    <SolidColorBrush x:Key="Mk20GridBorderBrush" Color="#293640" />
    <SolidColorBrush x:Key="Mk20KeyBrush" Color="#101820" />
    <SolidColorBrush x:Key="Mk20KeyBorderBrush" Color="#344554" />
    <SolidColorBrush x:Key="Mk20KeyScreenBrush" Color="#0A0F14" />
    <SolidColorBrush x:Key="Mk20KeyScreenBorderBrush" Color="#1D2A35" />
    <SolidColorBrush x:Key="Mk20EncoderBrush" Color="#202B35" />
    <SolidColorBrush x:Key="Mk20EncoderBorderBrush" Color="#435363" />
    <SolidColorBrush x:Key="Mk20SecondaryScreenBrush" Color="#071114" />
    <SolidColorBrush x:Key="Mk20SecondaryScreenBorderBrush" Color="#2B3B46" />

    <!-- Section card: one per collapsible menu, so the three read as blocks. -->
    <Style x:Key="Mk20SectionBorderStyle" TargetType="Border">
        <Setter Property="Margin" Value="0,10,0,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="#121820" />
        <Setter Property="BorderBrush" Value="#2E3B47" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style x:Key="Mk20SectionHeaderBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Background" Value="#18212B" />
        <Setter Property="BorderBrush" Value="#2E3B47" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="5,5,0,0" />
    </Style>

    <Style x:Key="Mk20SectionHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Mk20AccentBrush}" />
    </Style>

    <!-- Keystroke recorder: dark field that highlights while capturing. -->
    <Style TargetType="{x:Type ui:KeystrokeRecorder}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:KeystrokeRecorder}">
                    <Border x:Name="Field"
                            Padding="10,0"
                            Background="#0D141B"
                            BorderBrush="#2E3B47"
                            BorderThickness="1"
                            CornerRadius="4">
                        <ContentPresenter x:Name="Label"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          TextBlock.FontFamily="Consolas"
                                          TextBlock.FontSize="12"
                                          TextBlock.Foreground="{StaticResource Mk20FaintTextBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasKeystroke" Value="True">
                            <Setter TargetName="Label" Property="TextBlock.Foreground" Value="{StaticResource Mk20PrimaryTextBrush}" />
                            <Setter TargetName="Label" Property="TextBlock.FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource Mk20AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsRecording" Value="True">
                            <Setter TargetName="Field" Property="Background" Value="#14302C" />
                            <Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource Mk20AccentBrush}" />
                            <Setter TargetName="Field" Property="BorderThickness" Value="2" />
                            <Setter TargetName="Label" Property="TextBlock.Foreground" Value="{StaticResource Mk20AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One MK20 key: an LCD face inside a keycap. -->
    <Style x:Key="Mk20KeyStyle" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="KeyBody"
                            Background="{StaticResource Mk20KeyBrush}"
                            BorderBrush="{StaticResource Mk20KeyBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Grid Margin="6">
                            <Border Background="{StaticResource Mk20KeyScreenBrush}"
                                    BorderBrush="{StaticResource Mk20KeyScreenBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7" />
                            <ContentPresenter />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="KeyBody" Property="Background" Value="#14242A" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="KeyBody" Property="BorderBrush" Value="{StaticResource Mk20AccentBrush}" />
                            <Setter TargetName="KeyBody" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Key face: artwork if assigned, otherwise a placeholder, plus its label. -->
    <DataTemplate x:Key="Mk20KeyTemplate">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ui:AnimatedImage Grid.RowSpan="2"
                              SourcePath="{Binding MediaPath}"
                              Viewbox="{Binding IconViewbox}"
                              Stretch="{Binding IconStretch}" />

            <!-- Preview of the on-device text, in its chosen colour and position. -->
            <TextBlock Grid.RowSpan="2"
                       Margin="2,3"
                       HorizontalAlignment="Center"
                       VerticalAlignment="{Binding TitleAlignment}"
                       FontSize="10" FontWeight="SemiBold"
                       Foreground="{Binding TitleBrush}"
                       Text="{Binding Title}"
                       TextTrimming="CharacterEllipsis"
                       Visibility="{Binding HasTitle, Converter={StaticResource BooleanToVisibility}}" />

            <TextBlock x:Name="Placeholder"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="22" FontWeight="Light"
                       Foreground="#415261"
                       Text="+" />

            <TextBlock x:Name="NavGlyph"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="20"
                       Foreground="{StaticResource Mk20AccentBrush}"
                       Text="{Binding NavigationGlyph}"
                       Visibility="Collapsed" />

            <Ellipse Width="7" Height="7"
                     Margin="0,4,4,0"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Fill="{StaticResource Mk20AccentBrush}"
                     Visibility="{Binding HasAction, Converter={StaticResource BooleanToVisibility}}" />

            <TextBlock Grid.Row="1"
                       Margin="0,0,0,3"
                       HorizontalAlignment="Center"
                       FontSize="9" FontWeight="SemiBold"
                       Foreground="{StaticResource Mk20MutedTextBrush}"
                       Text="{Binding Label}" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HasMedia}" Value="True">
                <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HasNavigationGlyph}" Value="True">
                <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="NavGlyph" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding HasNavigationGlyph}" Value="True" />
                    <Condition Binding="{Binding HasMedia}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="NavGlyph" Property="Visibility" Value="Collapsed" />
            </MultiDataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Page/folder entry in the page selector. -->
    <DataTemplate x:Key="Mk20PageTemplate">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Name}" />
            <TextBlock Margin="6,0,0,0"
                       Foreground="{StaticResource Mk20FaintTextBrush}"
                       Text="{Binding Kind}" />
        </StackPanel>
    </DataTemplate>

    <Style x:Key="Mk20EncoderStyle" TargetType="Button">
        <Setter Property="Width" Value="76" />
        <Setter Property="Height" Value="76" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="OuterRing"
                                 Fill="{StaticResource Mk20EncoderBrush}"
                                 Stroke="{StaticResource Mk20EncoderBorderBrush}"
                                 StrokeThickness="2" />
                        <Ellipse Margin="10"
                                 Fill="{StaticResource Mk20KeyBrush}"
                                 Stroke="{StaticResource Mk20KeyScreenBorderBrush}"
                                 StrokeThickness="1" />
                        <Rectangle Width="3" Height="16"
                                   Margin="0,9,0,0"
                                   VerticalAlignment="Top"
                                   Fill="{StaticResource Mk20AccentBrush}"
                                   RadiusX="1.5" RadiusY="1.5" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OuterRing" Property="Stroke" Value="{StaticResource Mk20AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
