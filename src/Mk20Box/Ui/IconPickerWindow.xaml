<Window x:Class="Mk20Box.Ui.IconPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose an icon"
        Width="880" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="#12181F"
        Foreground="#F4F7FA">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="3"
                   Margin="0,0,0,10"
                   Foreground="#8492A3"
                   Text="Icons bundled with the plugin. Pick a category or search by name." />

        <ListBox x:Name="CategoryList"
                 Grid.Row="1"
                 Background="#0D141B" BorderBrush="#263442" BorderThickness="1"
                 Foreground="#F4F7FA"
                 SelectionChanged="FilterChanged" />

        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBox x:Name="SearchBox"
                     Height="28" Margin="0,0,0,8"
                     Background="#0D141B" BorderBrush="#263442"
                     Foreground="#F4F7FA"
                     TextChanged="FilterChanged"
                     ToolTip="Search icon names" />

            <ListBox x:Name="IconList"
                     Grid.Row="1"
                     Background="#0D141B" BorderBrush="#263442" BorderThickness="1"
                     MouseDoubleClick="IconList_MouseDoubleClick"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="96" Margin="6" ToolTip="{Binding Name}">
                            <Border Width="80" Height="80"
                                    HorizontalAlignment="Center"
                                    Background="#0A0F14"
                                    BorderBrush="#1D2A35" BorderThickness="1"
                                    CornerRadius="6">
                                <Image Margin="4" Source="{Binding Path}" Stretch="Uniform" />
                            </Border>
                            <TextBlock Margin="0,4,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="10"
                                       Foreground="#8492A3"
                                       Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0">
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="#8492A3" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Width="90" Height="30" Margin="0,0,8,0"
                        Click="Choose_Click" Content="Choose" IsDefault="True" />
                <Button Width="90" Height="30"
                        Content="Cancel" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
